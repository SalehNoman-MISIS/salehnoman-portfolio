# ---------------------------------------------------------------------------
# Admin panel (the /admin content editor). Copy to .env.local for local dev,
# and set the same values in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Required: the password that gates the /admin editor (min 6 characters).
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: extra secret used to sign the admin session cookie.
# If omitted, one is derived from ADMIN_PASSWORD (fine to leave blank).
SESSION_SECRET=

# Required IN PRODUCTION so "Save" can commit your edits back to the repo
# (which triggers a Vercel redeploy). Create a GitHub *fine-grained* token with
# "Contents: Read and write" permission on this one repository.
# Leave it unset locally — saves then write to your local content/ files instead.
GITHUB_TOKEN=

# The repo the admin commits to, and the branch. Defaults shown.
GITHUB_REPO=SalehNoman-MISIS/salehnoman-portfolio
GITHUB_BRANCH=main

# Optional: your production URL, used for canonical/OG/sitemap once you add a
# custom domain. On Vercel this is detected automatically if left unset.
NEXT_PUBLIC_SITE_URL=
